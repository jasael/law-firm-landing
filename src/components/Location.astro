---
---
<section id="ubicacion" class="py-24 bg-primary relative overflow-hidden px-6">
  
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
    
    <!-- Left Column: Location Details & Prestigious Hours -->
    <div class="lg:col-span-5 space-y-8">
      <div class="space-y-2">
        <span class="font-sans text-[10px] tracking-widest uppercase font-semibold text-accent block">Nuestra Sede</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-wide leading-tight">
          Presencia Física <br />
          <span class="text-accent">De Primer Nivel</span>
        </h2>
        <div class="w-16 h-1 bg-accent mt-2"></div>
      </div>
      
      <p class="font-sans text-sm text-slate-300 leading-relaxed font-light">
        Nuestras oficinas centrales están diseñadas bajo rigurosos protocolos de privacidad y discreción comercial, ofreciendo salas de juntas corporativas equipadas con tecnología de cifrado avanzado.
      </p>
      
      <!-- List of Info details -->
      <div class="space-y-6 font-sans">
        <!-- Address info item -->
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-sm bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-serif text-xs font-bold text-slate-200 uppercase tracking-widest">Dirección</h4>
            <p class="text-xs text-slate-400 mt-1 leading-relaxed">
              Av. del Libertador 1450, Piso 18<br />
              C1425 Buenos Aires, Argentina
            </p>
          </div>
        </div>
        
        <!-- Office Hours info item -->
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-sm bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-serif text-xs font-bold text-slate-200 uppercase tracking-widest">Horarios de Atención</h4>
            <p class="text-xs text-slate-400 mt-1 leading-relaxed">
              Lunes a Viernes: 09:00 - 18:30 (Huso Horario Local)<br />
              Atención Telefónica de Urgencias: 24/7 (Clientes Premium)
            </p>
          </div>
        </div>

        <!-- General Phone info item -->
        <div class="flex items-start space-x-4">
          <div class="w-10 h-10 rounded-sm bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-serif text-xs font-bold text-slate-200 uppercase tracking-widest">Contacto Directo</h4>
            <p class="text-xs text-slate-400 mt-1 leading-relaxed">
              Teléfono: +54 (11) 4892-9000<br />
              Email: <a href="mailto:socios@aurelius-abogados-fake.com" class="text-accent underline hover:text-accent-light">socios@aurelius.com</a>
            </p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Column: Interactive Map Frame Container -->
    <div class="lg:col-span-7">
      <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] bg-secondary border border-accent/20 p-2 rounded-sm shadow-2xl overflow-hidden group">
        <!-- Golden Corner Accents -->
        <div class="absolute top-0 left-0 w-4 h-4 border-t border-l border-accent/40"></div>
        <div class="absolute top-0 right-0 w-4 h-4 border-t border-r border-accent/40"></div>
        <div class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-accent/40"></div>
        <div class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-accent/40"></div>
        
        <!-- Google Map Iframe Styled to match dark UI of the landing -->
        <iframe 
          title="Ubicación de Aurelius & Asociados en Buenos Aires"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1m4!2s0x95bcb57f9ed566ff:0x5e81d77cb3c5bd56!2sAv.+del+Libertador+1450!5m2!1ses!2sar" 
          class="w-full h-full grayscale opacity-85 hover:grayscale-0 hover:opacity-100 transition-all duration-700 border-0 rounded-xs"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
    
  </div>
</section>

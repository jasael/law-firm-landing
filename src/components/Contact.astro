---
import { firmConfig } from '../config/firm';
---
<section id="contacto" class="py-24 bg-secondary relative overflow-hidden px-6">
  
  <!-- Decorative Background Shapes -->
  <div class="absolute bottom-0 right-0 w-96 h-96 rounded-full bg-accent/3 blur-[120px] pointer-events-none"></div>
  <div class="absolute top-0 left-0 w-full h-12 bg-primary shape-slant-l opacity-25"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 relative z-10">
    
    <!-- Left Column: Copy & Conversion Persuasion -->
    <div class="lg:col-span-5 space-y-6">
      <div class="space-y-2">
        <span class="font-sans text-[10px] tracking-widest uppercase font-semibold text-accent block">Triage & Citas</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-wide leading-tight">
          Agendar Una <span class="text-accent">Consulta Privada</span>
        </h2>
        <div class="w-16 h-1 bg-accent mt-2"></div>
      </div>
      
      <p class="font-sans text-sm text-slate-300 leading-relaxed font-light">
        Complete nuestro protocolo preliminar de calificación para asignar su caso al socio especialista idóneo y coordinar su cita formalmente vía WhatsApp.
      </p>
      
      <div class="space-y-4 font-sans text-xs text-slate-400">
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>Tratamiento Confidencial & Secreto Profesional de la Abogacía</span>
        </div>
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>Filtro Procesal: Asesoría Preventiva o Litigio en Curso</span>
        </div>
        <div class="flex items-center space-x-2">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>Respuesta Inmediata y Confirmación de Agenda en WhatsApp</span>
        </div>
      </div>
    </div>
    
    <!-- Right Column: Interactive Booking Form with Client Validation -->
    <div class="lg:col-span-7">
      <div class="glass-panel p-8 sm:p-10 rounded-sm shadow-2xl relative" id="booking-container">
        
        <!-- Successful Feedback Message Segment (Hidden by default) -->
        <div class="hidden absolute inset-0 bg-secondary/98 backdrop-blur-md z-20 flex-col items-center justify-center text-center p-8 space-y-6" id="booking-success-screen">
          <div class="w-16 h-16 bg-accent/10 border-2 border-accent text-accent rounded-full flex items-center justify-center animate-bounce">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-2xl font-bold text-slate-100">Ficha de Caso Generada</h3>
            <p class="font-sans text-xs text-slate-400 uppercase tracking-widest text-accent">ID de Trámite: <span id="booking-success-id" class="font-bold">AURE-0000</span></p>
          </div>
          <p class="font-sans text-xs sm:text-sm text-slate-300 max-w-md leading-relaxed font-light">
            Estimado/a <strong id="booking-success-name" class="text-white">Cliente</strong>, su expediente preliminar ha sido registrado. Para asignar fecha y hora definitiva con el abogado especialista, haga clic en el botón inferior para abrir el chat oficial en WhatsApp.
          </p>

          <!-- WhatsApp Action Button -->
          <div class="w-full max-w-md space-y-3 pt-2">
            <a 
              href="#" 
              id="booking-whatsapp-redirect-btn" 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-4 px-6 bg-[#25d366] hover:bg-[#20ba5a] text-white font-sans text-xs uppercase tracking-widest font-bold rounded-xs shadow-lg transition-all duration-300 flex items-center justify-center space-x-3 cursor-pointer"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.457L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.963C16.59 1.98 14.12 .953 11.5 .953c-5.44 0-9.865 4.371-9.87 9.8a9.69 9.69 0 0 0 1.54 5.212l-.995 3.635 3.799-.98.083.048zm12.39-6.425c-.269-.134-1.593-.78-1.837-.867-.243-.087-.421-.132-.599.133-.178.265-.689.867-.844 1.04-.155.174-.311.196-.58.062-.269-.134-1.137-.417-2.167-1.332-.8-.711-1.34-1.591-1.498-1.86-.157-.269-.017-.414.118-.548.121-.12.269-.314.403-.47.135-.157.179-.269.269-.449.09-.179.045-.337-.022-.47-.067-.134-.599-1.432-.821-1.966-.216-.517-.432-.447-.599-.456-.154-.008-.332-.01-.511-.01s-.47.067-.714.332c-.244.265-.93.907-.93 2.21 0 1.304.954 2.562 1.087 2.738.134.177 1.88 2.858 4.549 3.998.634.271 1.13.434 1.517.556.638.201 1.218.173 1.678.105.512-.075 1.593-.647 1.815-1.27.222-.624.222-1.159.155-1.27-.067-.11-.243-.196-.512-.33z"/>
              </svg>
              <span>Continuar a WhatsApp Oficial</span>
            </a>

            <button class="text-slate-400 hover:text-accent transition-colors font-sans text-[11px] uppercase tracking-widest font-semibold block mx-auto pt-2" id="booking-reset-btn">
              Modificar Datos o Nueva Consulta
            </button>
          </div>
        </div>

        <!-- Form fields layout -->
        <form class="space-y-5 font-sans text-xs" id="booking-form" novalidate data-whatsapp={firmConfig.whatsapp} data-firmname={firmConfig.name}>
          
          <!-- Bloque 1: Contacto Básico -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Fullname Input -->
            <div class="space-y-1.5">
              <label for="booking-name" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Nombre Completo <span class="text-accent">*</span></label>
              <input 
                type="text" 
                id="booking-name" 
                name="name" 
                required 
                placeholder="Ej. Lic. Roberto Gómez" 
                class="w-full bg-primary/60 border border-slate-800 focus:border-accent text-slate-100 px-3.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs"
              />
              <span class="text-[10px] text-red-400 hidden" id="booking-error-name">Por favor, ingrese su nombre.</span>
            </div>
            
            <!-- Email Input -->
            <div class="space-y-1.5">
              <label for="booking-email" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Correo Electrónico <span class="text-accent">*</span></label>
              <input 
                type="email" 
                id="booking-email" 
                name="email" 
                required 
                placeholder="Ej. roberto.gomez@empresa.com" 
                class="w-full bg-primary/60 border border-slate-800 focus:border-accent text-slate-100 px-3.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs"
              />
              <span class="text-[10px] text-red-400 hidden" id="booking-error-email">Ingrese un correo válido.</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Phone Input -->
            <div class="space-y-1.5">
              <label for="booking-phone" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Teléfono Celular / WhatsApp <span class="text-accent">*</span></label>
              <input 
                type="tel" 
                id="booking-phone" 
                name="phone" 
                required 
                placeholder="Ej. 55 1234 5678" 
                class="w-full bg-primary/60 border border-slate-800 focus:border-accent text-slate-100 px-3.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs"
              />
              <span class="text-[10px] text-red-400 hidden" id="booking-error-phone">Ingrese un teléfono de contacto.</span>
            </div>
            
            <!-- Law Practice Area Selector -->
            <div class="space-y-1.5">
              <label for="booking-area" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Materia o Rama Legal <span class="text-accent">*</span></label>
              <select 
                id="booking-area" 
                name="area" 
                required
                class="w-full bg-primary/95 border border-slate-800 focus:border-accent text-slate-100 px-3.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Seleccione la materia...</option>
                {firmConfig.practiceAreas.map((area) => (
                  <option value={area.id}>{area.name}</option>
                ))}
              </select>
              <span class="text-[10px] text-red-400 hidden" id="booking-error-area">Seleccione un área jurídica.</span>
            </div>
          </div>

          <!-- Bloque 2: Triage Procesal (Filtro Calificador de Clientes) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
            <!-- Estado del Caso -->
            <div class="space-y-1.5">
              <label for="booking-status" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Estado del Proceso <span class="text-accent">*</span></label>
              <select 
                id="booking-status" 
                name="case_status" 
                required
                class="w-full bg-primary/95 border border-slate-800 focus:border-accent text-slate-100 px-2.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Estado actual...</option>
                <option value="preventivo">Asesoría / Sin demanda aún</option>
                <option value="notificado">Fui notificado / Hay demanda</option>
                <option value="expediente">Con expediente judicial abierto</option>
              </select>
              <span class="text-[10px] text-red-400 hidden" id="booking-error-status">Indique el estado procesal.</span>
            </div>

            <!-- Urgencia Procesal -->
            <div class="space-y-1.5">
              <label for="booking-urgency" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Término Judicial <span class="text-accent">*</span></label>
              <select 
                id="booking-urgency" 
                name="urgency" 
                required
                class="w-full bg-primary/95 border border-slate-800 focus:border-accent text-slate-100 px-2.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Urgencia...</option>
                <option value="ordinaria">Ordinaria (Próximas semanas)</option>
                <option value="urgente">¡URGENTE! (Término &lt; 72 hrs)</option>
              </select>
              <span class="text-[10px] text-red-400 hidden" id="booking-error-urgency">Seleccione urgencia.</span>
            </div>

            <!-- Modalidad -->
            <div class="space-y-1.5">
              <label for="booking-modality" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Modalidad de Cita <span class="text-accent">*</span></label>
              <select 
                id="booking-modality" 
                name="modality" 
                required
                class="w-full bg-primary/95 border border-slate-800 focus:border-accent text-slate-100 px-2.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Modalidad...</option>
                <option value="presencial">Presencial (Oficina Texcoco/CDMX)</option>
                <option value="videollamada">Videollamada Remota</option>
              </select>
              <span class="text-[10px] text-red-400 hidden" id="booking-error-modality">Seleccione modalidad.</span>
            </div>
          </div>

          <!-- Resumen de los Hechos -->
          <div class="space-y-1.5">
            <label for="booking-message" class="block font-serif text-[10px] uppercase tracking-widest text-slate-300 font-semibold">Breve Resumen de los Hechos</label>
            <textarea 
              id="booking-message" 
              name="message" 
              rows="3" 
              placeholder="Describa brevemente la situación o el motivo de la consulta..." 
              class="w-full bg-primary/60 border border-slate-800 focus:border-accent text-slate-100 px-3.5 py-2.5 rounded-xs outline-none transition-colors duration-300 text-xs resize-none"
            ></textarea>
          </div>

          <!-- Submit Action Button -->
          <div class="pt-2">
            <button 
              type="submit" 
              id="booking-submit-btn" 
              class="gold-gradient-btn w-full py-3.5 font-sans text-xs uppercase tracking-widest font-bold rounded-xs cursor-pointer flex items-center justify-center space-x-2"
            >
              <span id="btn-text">Generar Ficha & Agendar por WhatsApp</span>
              <!-- Spinner (Hidden by default) -->
              <svg class="w-4 h-4 text-primary animate-spin hidden" id="btn-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                <path d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
          
        </form>
      </div>
    </div>

  </div>
</section>

<script>
  // Script de Triage Legal & Despacho a WhatsApp
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('booking-submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const successScreen = document.getElementById('booking-success-screen');
  const successName = document.getElementById('booking-success-name');
  const successId = document.getElementById('booking-success-id');
  const resetBtn = document.getElementById('booking-reset-btn');
  const waBtn = document.getElementById('booking-whatsapp-redirect-btn') as HTMLAnchorElement | null;

  // Inputs
  const inputName = document.getElementById('booking-name') as HTMLInputElement | null;
  const inputEmail = document.getElementById('booking-email') as HTMLInputElement | null;
  const inputPhone = document.getElementById('booking-phone') as HTMLInputElement | null;
  const selectArea = document.getElementById('booking-area') as HTMLSelectElement | null;
  const selectStatus = document.getElementById('booking-status') as HTMLSelectElement | null;
  const selectUrgency = document.getElementById('booking-urgency') as HTMLSelectElement | null;
  const selectModality = document.getElementById('booking-modality') as HTMLSelectElement | null;
  const textMessage = document.getElementById('booking-message') as HTMLTextAreaElement | null;

  // Errores
  const errorName = document.getElementById('booking-error-name');
  const errorEmail = document.getElementById('booking-error-email');
  const errorPhone = document.getElementById('booking-error-phone');
  const errorArea = document.getElementById('booking-error-area');
  const errorStatus = document.getElementById('booking-error-status');
  const errorUrgency = document.getElementById('booking-error-urgency');
  const errorModality = document.getElementById('booking-error-modality');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    let hasErrors = false;

    // Validación Nombre
    if (!inputName?.value.trim()) {
      errorName?.classList.remove('hidden');
      inputName?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorName?.classList.add('hidden');
      inputName?.classList.remove('border-red-400');
    }

    // Validación Email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!inputEmail?.value.trim() || !emailRegex.test(inputEmail.value)) {
      errorEmail?.classList.remove('hidden');
      inputEmail?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorEmail?.classList.add('hidden');
      inputEmail?.classList.remove('border-red-400');
    }

    // Validación Teléfono
    if (!inputPhone?.value.trim()) {
      errorPhone?.classList.remove('hidden');
      inputPhone?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorPhone?.classList.add('hidden');
      inputPhone?.classList.remove('border-red-400');
    }

    // Validación Área
    if (!selectArea?.value) {
      errorArea?.classList.remove('hidden');
      selectArea?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorArea?.classList.add('hidden');
      selectArea?.classList.remove('border-red-400');
    }

    // Validación Estado
    if (!selectStatus?.value) {
      errorStatus?.classList.remove('hidden');
      selectStatus?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorStatus?.classList.add('hidden');
      selectStatus?.classList.remove('border-red-400');
    }

    // Validación Urgencia
    if (!selectUrgency?.value) {
      errorUrgency?.classList.remove('hidden');
      selectUrgency?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorUrgency?.classList.add('hidden');
      selectUrgency?.classList.remove('border-red-400');
    }

    // Validación Modalidad
    if (!selectModality?.value) {
      errorModality?.classList.remove('hidden');
      selectModality?.classList.add('border-red-400');
      hasErrors = true;
    } else {
      errorModality?.classList.add('hidden');
      selectModality?.classList.remove('border-red-400');
    }

    if (hasErrors) return;

    // Estado cargando
    submitBtn.disabled = true;
    btnText?.classList.add('hidden');
    btnSpinner?.classList.remove('hidden');

    await new Promise((resolve) => setTimeout(resolve, 800));

    // Generar ID de caso formal
    const randomID = Math.floor(1000 + Math.random() * 9000);
    const caseId = `AURE-${randomID}`;

    const firmWhatsApp = form.dataset.whatsapp || "525544568319";
    const firmName = form.dataset.firmname || "Aurelius & Asociados";

    const nameVal = inputName?.value.trim() || "";
    const emailVal = inputEmail?.value.trim() || "";
    const phoneVal = inputPhone?.value.trim() || "";
    const areaText = selectArea?.options[selectArea.selectedIndex]?.text || "";
    const statusText = selectStatus?.options[selectStatus.selectedIndex]?.text || "";
    const urgencyText = selectUrgency?.options[selectUrgency.selectedIndex]?.text || "";
    const modalityText = selectModality?.options[selectModality.selectedIndex]?.text || "";
    const messageVal = textMessage?.value.trim() || "Ninguna observación adicional.";

    // Estructurar el mensaje para WhatsApp
    const waText = 
      `⚖️ *SOLICITUD DE CONSULTA LEGAL - ${firmName.toUpperCase()}*\n\n` +
      `📋 *Ficha ID:* ${caseId}\n` +
      `👤 *Cliente:* ${nameVal}\n` +
      `📞 *Teléfono:* ${phoneVal}\n` +
      `📧 *Email:* ${emailVal}\n` +
      `📂 *Materia:* ${areaText}\n` +
      `⚖️ *Estado:* ${statusText}\n` +
      `⏱️ *Término:* ${urgencyText}\n` +
      `📍 *Modalidad:* ${modalityText}\n` +
      `📝 *Hechos:* ${messageVal}\n\n` +
      `_Hola, acabo de completar el formulario y deseo coordinar la fecha de mi consulta._`;

    const finalWaUrl = `https://wa.me/${firmWhatsApp}?text=${encodeURIComponent(waText)}`;

    if (waBtn) {
      waBtn.href = finalWaUrl;
    }

    // Actualizar pantalla de éxito
    if (successScreen) {
      if (successName) successName.textContent = nameVal;
      if (successId) successId.textContent = caseId;
      successScreen.classList.remove('hidden');
      successScreen.classList.add('flex');
    }

    // Restaurar botón
    submitBtn.disabled = false;
    btnText?.classList.remove('hidden');
    btnSpinner?.classList.add('hidden');
  });

  // Reiniciar formulario
  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successScreen?.classList.add('hidden');
    successScreen?.classList.remove('flex');
  });
</script>

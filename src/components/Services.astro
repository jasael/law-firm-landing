---
const services = [
  {
    icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
    title: "Derecho Corporativo & Fusiones",
    desc: "Estructuración de holdings, acuerdos de accionistas comerciales complejos, adquisiciones estratégicas transfronterizas y reorganizaciones societarias complejas."
  },
  {
    icon: "M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",
    title: "Propiedad Intelectual & Patentes",
    desc: "Blindaje de patentes científicas y tecnológicas, registro global de marcas comerciales y defensa legal en litigios por competencia desleal o plagio."
  },
  {
    icon: "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6", // Scales of justice SVG paths below
    isScales: true,
    title: "Litigios de Alto Perfil & Arbitraje",
    desc: "Representación judicial asertiva en cortes comerciales complejas, resolución alternativa de disputas bajo reglamentos arbitrales de elite mundial."
  },
  {
    icon: "M3 3h18v18H3V3zm6 6h6m-6 4h6m-6 4h3",
    title: "Planificación Fiscal & Corporativa",
    desc: "Diseño e implementación de estructuras de optimización fiscal lícita, auditoría de contingencias tributarias y blindaje de patrimonios ejecutivos."
  }
];
---

<section id="servicios" class="py-24 bg-primary relative overflow-hidden px-6">
  
  <!-- Subtle golden blur circles -->
  <div class="absolute top-1/2 left-0 w-80 h-80 rounded-full bg-accent/3 blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- Section Header Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <span class="font-sans text-[10px] tracking-widest uppercase font-semibold text-accent block">Áreas de Práctica</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-wide leading-tight">
        Soluciones Legales <span class="text-accent">De Alta Ingeniería</span>
      </h2>
      <div class="w-16 h-1 bg-accent mx-auto mt-2"></div>
      <p class="font-sans text-sm text-slate-400 max-w-xl mx-auto leading-relaxed font-light">
        No creemos en respuestas genéricas. Cada disciplina legal es abordada bajo un análisis milimétrico para entregar certidumbre corporativa de nivel premium.
      </p>
    </div>

    <!-- Practice Areas Cards Grid Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
      {services.map((svc) => (
        <div class="glass-panel p-8 sm:p-10 rounded-sm hover:border-accent/40 hover:-translate-y-1 transition-all duration-300 relative group flex flex-col justify-between">
          
          <div class="space-y-6">
            <!-- Icon element wrapper -->
            <div class="w-12 h-12 rounded-sm bg-accent/10 border border-accent/25 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-primary transition-all duration-500">
              {svc.isScales ? (
                /* Scales of Justice Custom Vector Icon */
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1M21 16v1a2 2 0 0 1-2 2h-3M12 2v18M12 22H2M12 2H22M5 7l3-3 3 3M19 7l-3-3-3 3" />
                </svg>
              ) : (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={svc.icon} />
                </svg>
              )}
            </div>
            
            <div class="space-y-3">
              <h3 class="font-serif text-lg font-bold text-slate-100 tracking-wide uppercase group-hover:text-accent transition-colors duration-300">
                {svc.title}
              </h3>
              <p class="font-sans text-xs text-slate-400 leading-relaxed font-light">
                {svc.desc}
              </p>
            </div>
          </div>
          
          <!-- Subtle corner accent line -->
          <div class="absolute bottom-4 right-4 w-6 h-6 border-b border-r border-transparent group-hover:border-accent/40 transition-all duration-500"></div>
          
        </div>
      ))}
    </div>

  </div>
</section>

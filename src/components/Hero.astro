---
---
<section id="inicio" class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-primary py-20 px-6">
  
  <!-- Subtle Executive Gold/Blue Glow Orbs -->
  <div class="absolute top-1/4 left-1/10 w-96 h-96 rounded-full bg-accent/5 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/10 w-[450px] h-[450px] rounded-full bg-secondary/15 blur-[150px] pointer-events-none"></div>
  
  <!-- Geometric Decorative Lines in background -->
  <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>
  
  <!-- Elegant Angled Geometric Bottom Accent (Polygonal Shape) -->
  <div class="absolute bottom-0 left-0 w-full h-24 bg-secondary shape-slant-r border-t border-accent/10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
    
    <!-- Hero Text Information Content -->
    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
      <!-- Badge element -->
      <div class="inline-flex items-center space-x-2 bg-accent/10 border border-accent/30 px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-widest text-accent font-semibold font-sans animate-fade-in">
        <svg class="w-3.5 h-3.5 animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
        </svg>
        <span>Firma Legal Boutique de Élite</span>
      </div>
      
      <!-- Stately serif title with gradient and animation delays -->
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-wide text-slate-100 leading-[1.1] animate-fade-in-up">
        Defendemos Tu Éxito Con <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-accent-light to-accent-dark">
          Rigor & Distinción
        </span>
      </h1>
      
      <!-- Subtitle description -->
      <p class="max-w-xl mx-auto lg:mx-0 font-sans text-sm sm:text-base text-slate-300 leading-relaxed font-light animate-fade-in-up style={{ animationDelay: '0.2s' }}">
        En Aurelius & Asociados diseñamos estrategias legales complejas y personalizadas para corporaciones líderes y patrimonios ejecutivos. Rigurosidad intelectual al servicio de tus intereses.
      </p>
      
      <!-- Action buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4 animate-fade-in-up style={{ animationDelay: '0.4s' }}">
        <a href="#contacto" class="gold-gradient-btn px-8 py-4 font-sans text-xs uppercase tracking-widest font-bold rounded-xs w-full sm:w-auto text-center">
          Agendar Consulta Ejecutiva
        </a>
        <a href="#servicios" class="px-8 py-4 border border-slate-700 hover:border-accent hover:text-accent text-slate-200 transition-all duration-300 font-sans text-xs uppercase tracking-widest font-semibold rounded-xs w-full sm:w-auto text-center backdrop-blur-xs">
          Nuestras Áreas &rarr;
        </a>
      </div>
      
      <!-- Trust figures / metrics under hero -->
      <div class="grid grid-cols-3 gap-6 pt-10 border-t border-slate-800/60 max-w-md mx-auto lg:mx-0 text-center lg:text-left animate-fade-in">
        <div>
          <span class="block font-serif text-2xl sm:text-3xl font-bold text-accent">15+</span>
          <span class="text-[9px] uppercase tracking-wider text-slate-400 font-sans font-medium">Años de Trayectoria</span>
        </div>
        <div>
          <span class="block font-serif text-2xl sm:text-3xl font-bold text-accent">98%</span>
          <span class="text-[9px] uppercase tracking-wider text-slate-400 font-sans font-medium">Casos de Éxito</span>
        </div>
        <div>
          <span class="block font-serif text-2xl sm:text-3xl font-bold text-accent">1.2B+</span>
          <span class="text-[9px] uppercase tracking-wider text-slate-400 font-sans font-medium">Capital Protegido</span>
        </div>
      </div>
    </div>
    
    <!-- Hero Image / Visual Abstract Graphic -->
    <div class="lg:col-span-5 relative mt-6 lg:mt-0 animate-fade-in">
      <div class="relative w-full aspect-square max-w-[420px] mx-auto">
        <!-- Structural Golden Grid Box Layer -->
        <div class="absolute inset-0 border border-accent/20 rounded-md rotate-3 transform scale-102 transition-transform duration-500 hover:rotate-6"></div>
        <div class="absolute inset-0 border border-slate-800 rounded-md -rotate-3 transform scale-98"></div>
        
        <!-- Deep Executive Glass Card (Gleaming glassmorphism) -->
        <div class="absolute inset-2 rounded-md glass-panel p-8 flex flex-col justify-between overflow-hidden group">
          <!-- Abstract Golden Pillars (Stately design shape) -->
          <div class="absolute top-0 right-0 w-24 h-24 bg-accent/5 rounded-full blur-2xl pointer-events-none"></div>
          
          <div class="space-y-4">
            <svg class="w-12 h-12 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8a4 4 0 100 8 4 4 0 000-8z" />
            </svg>
            <h3 class="font-serif text-2xl font-bold text-slate-100 leading-snug">
              Jurisprudencia de <br /><span class="text-accent">Primer Nivel</span>
            </h3>
            <p class="font-sans text-xs text-slate-400 leading-relaxed">
              Cada dictamen es estructurado por comités de análisis interdisciplinarios, garantizando soluciones de rigurosa solidez jurídica internacional.
            </p>
          </div>
          
          <div class="pt-6 border-t border-slate-800/80 flex items-center justify-between text-xs font-sans tracking-widest text-accent font-semibold uppercase">
            <span>Certificación ISO 9001</span>
            <svg class="w-4 h-4 text-accent animate-bounce-horizontal" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</section>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }
  @keyframes bounce-horizontal {
    0%, 100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(4px);
    }
  }
  .animate-bounce-horizontal {
    animation: bounce-horizontal 1.5s infinite;
  }
</style>

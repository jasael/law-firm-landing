---
import Layout from '../../layouts/Layout.astro';
import { firmConfig } from '../../config/firm';
---

<Layout 
  title={`Panel de Control de Expedientes | ${firmConfig.name}`}
  description="Panel privado de gestión de casos, triage y seguimiento de clientes."
>
  <div class="min-h-screen bg-[#070b14] text-slate-100 font-sans pt-24 pb-16 px-4 sm:px-6 lg:px-8">
    
    <!-- Header del Dashboard -->
    <div class="max-w-7xl mx-auto mb-8 border-b border-accent/20 pb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-3 mb-1">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[10px] uppercase tracking-widest text-accent font-semibold">Sistema de Gestión de Clientes</span>
        </div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-wide text-white">
          Panel de Control <span class="text-accent">&amp; Expedientes</span>
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          {firmConfig.name} &bull; Triage en tiempo real y seguimiento procesal
        </p>
      </div>

      <div class="flex items-center space-x-3">
        <a 
          href="/" 
          target="_blank" 
          class="px-3.5 py-2 border border-slate-700 hover:border-accent text-slate-300 hover:text-white text-xs rounded-xs transition-colors"
        >
          Ver Landing Pública &nearr;
        </a>
        <button 
          id="btn-refresh-leads"
          class="px-4 py-2 bg-accent/15 hover:bg-accent/25 border border-accent/40 text-accent hover:text-white text-xs font-semibold rounded-xs transition-all flex items-center space-x-2"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span>Actualizar</span>
        </button>
      </div>
    </div>

    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- KPI Cards (Métricas Ejecutivas) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-secondary/70 border border-slate-800 p-5 rounded-xs space-y-2">
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold block">Total Solicitudes</span>
          <div class="flex items-baseline justify-between">
            <span class="font-serif text-3xl font-bold text-white" id="kpi-total">0</span>
            <span class="text-xs text-emerald-400 font-medium">100% captadas</span>
          </div>
        </div>

        <div class="bg-secondary/70 border border-red-500/30 p-5 rounded-xs space-y-2 relative overflow-hidden">
          <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-red-500/5 rounded-full pointer-events-none"></div>
          <span class="text-[10px] uppercase tracking-widest text-red-400 font-semibold block">Término Urgente (&lt; 72 hrs)</span>
          <div class="flex items-baseline justify-between">
            <span class="font-serif text-3xl font-bold text-red-400" id="kpi-urgent">0</span>
            <span class="text-[11px] text-red-300">Atención prioritaria</span>
          </div>
        </div>

        <div class="bg-secondary/70 border border-slate-800 p-5 rounded-xs space-y-2">
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold block">Con Expediente Abierto</span>
          <div class="flex items-baseline justify-between">
            <span class="font-serif text-3xl font-bold text-accent" id="kpi-lawsuits">0</span>
            <span class="text-xs text-slate-400">En litigio</span>
          </div>
        </div>

        <div class="bg-secondary/70 border border-slate-800 p-5 rounded-xs space-y-2">
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold block">Citas / En Trámite</span>
          <div class="flex items-baseline justify-between">
            <span class="font-serif text-3xl font-bold text-emerald-400" id="kpi-active">0</span>
            <span class="text-xs text-slate-400">Pipeline activo</span>
          </div>
        </div>
      </div>

      <!-- Barra de Filtros y Búsqueda -->
      <div class="bg-secondary/40 border border-slate-800 p-4 rounded-xs flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
          <!-- Búsqueda -->
          <div class="relative w-full sm:w-64">
            <input 
              type="text" 
              id="filter-search" 
              placeholder="Buscar cliente, tel o ID..." 
              class="w-full bg-primary/80 border border-slate-700 text-xs px-3 py-2 pl-8 rounded-xs text-slate-100 placeholder-slate-500 outline-none focus:border-accent"
            />
            <svg class="w-3.5 h-3.5 text-slate-500 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>

          <!-- Filtro por Estado -->
          <select 
            id="filter-status" 
            class="bg-primary/80 border border-slate-700 text-xs px-3 py-2 rounded-xs text-slate-200 outline-none focus:border-accent"
          >
            <option value="ALL">Todos los Estados</option>
            <option value="NUEVO">NUEVO</option>
            <option value="CONTACTADO">CONTACTADO</option>
            <option value="CITA_AGENDADA">CITA AGENDADA</option>
            <option value="EN_TRAMITE">EN TRÁMITE</option>
            <option value="CONCLUIDO">CONCLUIDO</option>
          </select>

          <!-- Filtro por Urgencia -->
          <select 
            id="filter-urgency" 
            class="bg-primary/80 border border-slate-700 text-xs px-3 py-2 rounded-xs text-slate-200 outline-none focus:border-accent"
          >
            <option value="ALL">Todas las Prioridades</option>
            <option value="urgente">Solo Urgentes (&lt; 72 hrs)</option>
            <option value="ordinaria">Solo Ordinarias</option>
          </select>
        </div>

        <div class="text-xs text-slate-400">
          Mostrando: <span id="leads-count" class="text-white font-bold">0</span> casos
        </div>
      </div>

      <!-- Tabla Principal de Casos -->
      <div class="bg-secondary/30 border border-slate-800 rounded-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-secondary/90 text-slate-400 font-serif uppercase tracking-widest text-[10px] border-b border-slate-800">
              <tr>
                <th class="py-3 px-4">Ficha ID</th>
                <th class="py-3 px-4">Fecha</th>
                <th class="py-3 px-4">Cliente</th>
                <th class="py-3 px-4">Materia / Proceso</th>
                <th class="py-3 px-4">Prioridad</th>
                <th class="py-3 px-4">Estado</th>
                <th class="py-3 px-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="leads-table-body" class="divide-y divide-slate-800/60 font-sans">
              <!-- Renderizado dinámico desde script -->
              <tr>
                <td colspan="7" class="py-12 text-center text-slate-500">
                  <div class="inline-block animate-spin w-5 h-5 border-2 border-accent border-t-transparent rounded-full mb-2"></div>
                  <p>Cargando expedientes desde Supabase...</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Modal / Drawer Lateral: Detalle de Ficha y Bitácora -->
    <div id="lead-drawer" class="fixed inset-0 bg-black/70 backdrop-blur-xs z-50 hidden justify-end">
      <div class="w-full max-w-xl bg-secondary h-full border-l border-accent/20 p-6 sm:p-8 overflow-y-auto flex flex-col justify-between">
        
        <div class="space-y-6">
          <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
              <span id="drawer-case-id" class="text-xs font-serif font-bold text-accent tracking-widest uppercase">AURE-0000</span>
              <h2 id="drawer-client-name" class="font-serif text-xl font-bold text-white mt-1">Nombre Cliente</h2>
            </div>
            <button id="drawer-close-btn" class="text-slate-400 hover:text-white p-2">
              &times;
            </button>
          </div>

          <!-- Información General -->
          <div class="grid grid-cols-2 gap-4 text-xs">
            <div>
              <span class="text-slate-400 text-[10px] uppercase block">Teléfono / WhatsApp</span>
              <span id="drawer-phone" class="text-white font-medium">--</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase block">Correo Electrónico</span>
              <span id="drawer-email" class="text-white font-medium">--</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase block">Materia Legal</span>
              <span id="drawer-area" class="text-accent font-medium">--</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase block">Modalidad</span>
              <span id="drawer-modality" class="text-white font-medium">--</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase block">Estado Procesal</span>
              <span id="drawer-status" class="text-white font-medium">--</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase block">Urgencia</span>
              <span id="drawer-urgency" class="text-white font-medium">--</span>
            </div>
          </div>

          <!-- Resumen de Hechos -->
          <div class="bg-primary/50 border border-slate-800 p-4 rounded-xs">
            <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold block mb-2">Resumen de Hechos Declarados</span>
            <p id="drawer-facts" class="text-xs text-slate-300 leading-relaxed font-light whitespace-pre-wrap">--</p>
          </div>

          <!-- Bitácora de Notas Confidenciales -->
          <div class="space-y-3">
            <span class="text-[10px] uppercase tracking-widest text-accent font-semibold block">Bitácora Interna del Abogado</span>
            <div id="drawer-notes-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
              <p class="text-xs text-slate-500 italic">No hay notas registradas para este expediente.</p>
            </div>

            <!-- Agregar Nota -->
            <div class="space-y-2 pt-2 border-t border-slate-800">
              <textarea 
                id="drawer-new-note" 
                rows="2" 
                placeholder="Agregar nota de llamada, acuerdo o avance..." 
                class="w-full bg-primary/70 border border-slate-700 text-xs p-2.5 rounded-xs text-slate-100 placeholder-slate-500 outline-none focus:border-accent resize-none"
              ></textarea>
              <button 
                id="drawer-save-note-btn" 
                class="px-4 py-1.5 bg-accent text-primary font-bold text-xs rounded-xs hover:bg-accent-light transition-colors"
              >
                Guardar Nota
              </button>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-800 flex items-center justify-between">
          <a 
            id="drawer-wa-btn" 
            href="#" 
            target="_blank" 
            class="px-4 py-2.5 bg-[#25d366] hover:bg-[#20ba5a] text-white text-xs font-bold rounded-xs flex items-center space-x-2 transition-colors"
          >
            <span>Abrir WhatsApp con Cliente</span>
          </a>
          <button id="drawer-close-footer" class="text-xs text-slate-400 hover:text-white">
            Cerrar Ficha
          </button>
        </div>

      </div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  let leadsData: any[] = [];
  let currentLead: any = null;

  const tableBody = document.getElementById('leads-table-body');
  const countSpan = document.getElementById('leads-count');
  const kpiTotal = document.getElementById('kpi-total');
  const kpiUrgent = document.getElementById('kpi-urgent');
  const kpiLawsuits = document.getElementById('kpi-lawsuits');
  const kpiActive = document.getElementById('kpi-active');

  const filterSearch = document.getElementById('filter-search') as HTMLInputElement | null;
  const filterStatus = document.getElementById('filter-status') as HTMLSelectElement | null;
  const filterUrgency = document.getElementById('filter-urgency') as HTMLSelectElement | null;
  const refreshBtn = document.getElementById('btn-refresh-leads');

  // Drawer
  const drawer = document.getElementById('lead-drawer');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const drawerCloseFooter = document.getElementById('drawer-close-footer');
  const drawerCaseId = document.getElementById('drawer-case-id');
  const drawerClientName = document.getElementById('drawer-client-name');
  const drawerPhone = document.getElementById('drawer-phone');
  const drawerEmail = document.getElementById('drawer-email');
  const drawerArea = document.getElementById('drawer-area');
  const drawerModality = document.getElementById('drawer-modality');
  const drawerStatus = document.getElementById('drawer-status');
  const drawerUrgency = document.getElementById('drawer-urgency');
  const drawerFacts = document.getElementById('drawer-facts');
  const drawerWaBtn = document.getElementById('drawer-wa-btn') as HTMLAnchorElement | null;
  const drawerNewNote = document.getElementById('drawer-new-note') as HTMLTextAreaElement | null;
  const drawerSaveNoteBtn = document.getElementById('drawer-save-note-btn');
  const drawerNotesList = document.getElementById('drawer-notes-list');

  // Cargar leads desde Supabase
  async function loadLeads() {
    try {
      const { data, error } = await supabase
        .from('legal_leads')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        renderMockOrError(error.message);
        return;
      }

      leadsData = data || [];
      updateKPIs(leadsData);
      renderTable(getFilteredLeads());
    } catch (err: any) {
      renderMockOrError(err.message);
    }
  }

  function updateKPIs(data: any[]) {
    if (kpiTotal) kpiTotal.textContent = String(data.length);
    if (kpiUrgent) {
      const urgentCount = data.filter((l) => l.urgency?.toLowerCase().includes('urgente')).length;
      kpiUrgent.textContent = String(urgentCount);
    }
    if (kpiLawsuits) {
      const lawsuits = data.filter((l) => l.case_status?.toLowerCase().includes('expediente')).length;
      kpiLawsuits.textContent = String(lawsuits);
    }
    if (kpiActive) {
      const active = data.filter((l) => ['CITA_AGENDADA', 'EN_TRAMITE'].includes(l.pipeline_status)).length;
      kpiActive.textContent = String(active);
    }
  }

  function getFilteredLeads() {
    const q = filterSearch?.value.toLowerCase().trim() || '';
    const st = filterStatus?.value || 'ALL';
    const urg = filterUrgency?.value || 'ALL';

    return leadsData.filter((l) => {
      const matchSearch =
        !q ||
        l.client_name?.toLowerCase().includes(q) ||
        l.case_id?.toLowerCase().includes(q) ||
        l.client_phone?.toLowerCase().includes(q);

      const matchStatus = st === 'ALL' || l.pipeline_status === st;
      const matchUrgency =
        urg === 'ALL' ||
        (urg === 'urgente' && l.urgency?.toLowerCase().includes('urgente')) ||
        (urg === 'ordinaria' && !l.urgency?.toLowerCase().includes('urgente'));

      return matchSearch && matchStatus && matchUrgency;
    });
  }

  function renderTable(leads: any[]) {
    if (!tableBody) return;
    if (countSpan) countSpan.textContent = String(leads.length);

    if (leads.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="7" class="py-12 text-center text-slate-500">
            No se encontraron expedientes con los filtros seleccionados.
          </td>
        </tr>
      `;
      return;
    }

    tableBody.innerHTML = leads.map((l) => {
      const isUrgent = l.urgency?.toLowerCase().includes('urgente');
      const dateStr = l.created_at ? new Date(l.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '--';

      const cleanPhone = (l.client_phone || '').replace(/\D/g, '');
      const waLink = cleanPhone ? `https://wa.me/52${cleanPhone}` : '#';

      return `
        <tr class="hover:bg-primary/40 transition-colors">
          <td class="py-3.5 px-4 font-mono font-bold text-accent text-xs">
            ${l.case_id || 'AURE-XXXX'}
          </td>
          <td class="py-3.5 px-4 text-slate-400 text-[11px] whitespace-nowrap">
            ${dateStr}
          </td>
          <td class="py-3.5 px-4">
            <div class="font-medium text-white">${l.client_name || 'Sin nombre'}</div>
            <div class="text-[11px] text-slate-400 flex items-center space-x-2 mt-0.5">
              <span>${l.client_phone || ''}</span>
              <a href="${waLink}" target="_blank" class="text-emerald-400 hover:underline">WhatsApp &nearr;</a>
            </div>
          </td>
          <td class="py-3.5 px-4">
            <div class="text-slate-200">${l.practice_area || 'General'}</div>
            <div class="text-[10px] text-slate-400">${l.case_status || ''}</div>
          </td>
          <td class="py-3.5 px-4">
            ${
              isUrgent
                ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500/15 text-red-400 border border-red-500/30 animate-pulse">URGENTE (&lt;72h)</span>'
                : '<span class="text-slate-400 text-[11px]">Ordinaria</span>'
            }
          </td>
          <td class="py-3.5 px-4">
            <select data-id="${l.id}" class="select-lead-status bg-primary border border-slate-700 text-[11px] py-1 px-2 rounded-xs text-slate-200 outline-none focus:border-accent cursor-pointer">
              <option value="NUEVO" ${l.pipeline_status === 'NUEVO' ? 'selected' : ''}>NUEVO</option>
              <option value="CONTACTADO" ${l.pipeline_status === 'CONTACTADO' ? 'selected' : ''}>CONTACTADO</option>
              <option value="CITA_AGENDADA" ${l.pipeline_status === 'CITA_AGENDADA' ? 'selected' : ''}>CITA AGENDADA</option>
              <option value="EN_TRAMITE" ${l.pipeline_status === 'EN_TRAMITE' ? 'selected' : ''}>EN TRÁMITE</option>
              <option value="CONCLUIDO" ${l.pipeline_status === 'CONCLUIDO' ? 'selected' : ''}>CONCLUIDO</option>
            </select>
          </td>
          <td class="py-3.5 px-4 text-right">
            <button data-case="${l.case_id}" class="btn-open-drawer px-3 py-1 bg-accent/15 hover:bg-accent/30 text-accent font-semibold text-[11px] rounded-xs transition-colors">
              Ficha & Bitácora
            </button>
          </td>
        </tr>
      `;
    }).join('');

    // Listeners para select de estado
    document.querySelectorAll('.select-lead-status').forEach((select) => {
      select.addEventListener('change', async (e: any) => {
        const id = e.target.dataset.id;
        const newStatus = e.target.value;
        await supabase.from('legal_leads').update({ pipeline_status: newStatus }).eq('id', id);
        const item = leadsData.find((x) => x.id === id);
        if (item) item.pipeline_status = newStatus;
        updateKPIs(leadsData);
      });
    });

    // Listeners para abrir drawer
    document.querySelectorAll('.btn-open-drawer').forEach((btn) => {
      btn.addEventListener('click', (e: any) => {
        const caseId = e.currentTarget.dataset.case;
        const lead = leadsData.find((x) => x.case_id === caseId);
        if (lead) openDrawer(lead);
      });
    });
  }

  function openDrawer(lead: any) {
    currentLead = lead;
    if (drawerCaseId) drawerCaseId.textContent = lead.case_id;
    if (drawerClientName) drawerClientName.textContent = lead.client_name;
    if (drawerPhone) drawerPhone.textContent = lead.client_phone || '--';
    if (drawerEmail) drawerEmail.textContent = lead.client_email || '--';
    if (drawerArea) drawerArea.textContent = lead.practice_area || '--';
    if (drawerModality) drawerModality.textContent = lead.modality || '--';
    if (drawerStatus) drawerStatus.textContent = lead.case_status || '--';
    if (drawerUrgency) drawerUrgency.textContent = lead.urgency || '--';
    if (drawerFacts) drawerFacts.textContent = lead.facts_summary || 'Sin hechos descritos.';

    const cleanPhone = (lead.client_phone || '').replace(/\D/g, '');
    if (drawerWaBtn) {
      drawerWaBtn.href = cleanPhone ? `https://wa.me/52${cleanPhone}` : '#';
    }

    loadNotes(lead.id);

    if (drawer) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
    }
  }

  function closeDrawer() {
    if (drawer) {
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
    }
  }

  async function loadNotes(leadId: string) {
    if (!drawerNotesList) return;
    drawerNotesList.innerHTML = '<p class="text-xs text-slate-500">Cargando notas...</p>';

    const { data, error } = await supabase
      .from('lead_notes')
      .select('*')
      .eq('lead_id', leadId)
      .order('created_at', { ascending: false });

    if (error || !data || data.length === 0) {
      drawerNotesList.innerHTML = '<p class="text-xs text-slate-500 italic">No hay notas registradas para este expediente.</p>';
      return;
    }

    drawerNotesList.innerHTML = data.map((n) => `
      <div class="bg-primary/40 border border-slate-800 p-2.5 rounded-xs space-y-1">
        <div class="flex items-center justify-between text-[10px] text-slate-400">
          <span class="font-medium text-accent">${n.author_email || 'Abogado'}</span>
          <span>${new Date(n.created_at).toLocaleString('es-MX')}</span>
        </div>
        <p class="text-xs text-slate-200 leading-snug">${n.note_content}</p>
      </div>
    `).join('');
  }

  drawerSaveNoteBtn?.addEventListener('click', async () => {
    if (!currentLead || !drawerNewNote?.value.trim()) return;
    const content = drawerNewNote.value.trim();

    await supabase.from('lead_notes').insert([
      {
        lead_id: currentLead.id,
        author_email: 'abogado@aurelius.com',
        note_content: content,
      }
    ]);

    drawerNewNote.value = '';
    loadNotes(currentLead.id);
  });

  function renderMockOrError(msg: string) {
    // Si Supabase local aún no tiene registros o no está levantado, muestra demo interactiva
    leadsData = [
      {
        id: '1',
        case_id: 'AURE-8921',
        created_at: new Date().toISOString(),
        client_name: 'Lic. Sergio Morales Ramos',
        client_phone: '55 4456 8319',
        client_email: 's.morales@empresa.com',
        practice_area: 'Derecho Corporativo & Mercantil',
        case_status: 'Fui notificado / Hay demanda',
        urgency: '¡URGENTE! (Término < 72 hrs)',
        modality: 'Presencial (Oficina Texcoco/CDMX)',
        facts_summary: 'Notificación de demanda mercantil recibida ayer con término para contestación el próximo lunes.',
        pipeline_status: 'NUEVO',
      },
      {
        id: '2',
        case_id: 'AURE-3412',
        created_at: new Date(Date.now() - 3600000 * 5).toISOString(),
        client_name: 'Dra. Elena Vega',
        client_phone: '55 1234 5678',
        client_email: 'elena.vega@salud.org',
